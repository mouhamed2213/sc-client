# Back-office Support Connecté (Supabase). Laisser vide = le site fonctionne seul (textes par défaut, demandes par e-mail).
VITE_LEAD_ENDPOINT=https://<PROJECT_REF>.supabase.co/functions/v1/lead-intake
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<ANON_KEY>

# Éditeur de fiche : « true » = données fictives (démo, hors ligne). Vide ou « false » = vraie API (GET / PATCH /api/fiches/:id).
VITE_USE_MOCK_FICHES=false


# URL de base de l’API Support Connecté, avec le suffixe /api.
# En local : http://localhost:4000/api
# En production : renseigner l’URL publique de l’API ou /api si le reverse proxy sert le même domaine.
VITE_API_URL=http://localhost:4000/api
