{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "types": ["node"],
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
