{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/secteurs/immobilier", "destination": "/promoteur-immobilier", "permanent": true }
  ],
  "rewrites": [
    { "source": "/q/:code", "destination": "https://PROJECT_REF.supabase.co/functions/v1/qr-redirect?c=:code" },
    { "source": "/f/:slug", "destination": "https://URL_OUTIL_MEMBRES/f/:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
